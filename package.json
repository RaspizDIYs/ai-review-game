{
  "name": "ai-review-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run pack && vite",
    "build": "npm run pack && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"src/*.test.ts\"",
    "validate": "node scripts/validate-pack.mjs",
    "check": "npm run pack && tsc -b && npm run test && npm run validate",
    "pack": "node scripts/build-pack.mjs",
    "new-task": "node scripts/new-task.mjs",
    "draft": "node scripts/draft-task.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "shiki": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
